# ------------- templates (примеры/генерация vs данные-переноса) -------------
# Не коммитим: генер. выхлоп подготовки, авто-копии, примеры печати, исходный Access.
/templates/clean/
/templates/Миграция_ЧИСТО.xlsx
/templates/*.pdf
/templates/Учет_коммунальных_be.accdb

/templates/*
# Но отслеживаем ФАЙЛЫ ДАННЫХ переноса (актуальная история + будущие месячные
# выгрузки „Миграция данных …“, чтобы довносить август/сентябрь и далее):
!/templates/Миграция данных FTH.xlsx
!/templates/Миграция данных FTH.ods
!/templates/Миграция данных FTH*.xlsx
!/templates/Миграция данных FTH*.ods
