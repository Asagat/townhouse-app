# Пример конфигурации nginx для Townhouse ERP (VPS).
# Скопируйте в /etc/nginx/sites-available/townhouse, замените __DOMAIN__
# на ваш домен, затем:
#   ln -s /etc/nginx/sites-available/townhouse /etc/nginx/sites-enabled/townhouse
#   nginx -t && systemctl reload nginx
#
# Топология после setup_vps.sh:
#   - backend:  systemd townhouse-backend  → 127.0.0.1:8000
#   - frontend: статика из frontend/dist (Node - production-сборка)

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Прокси на API (FastAPI). ВАЖНО: сохраняем /api/ (без переписания пути).
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA-статика (production-сборка фронтенда)
    location / {
        root __APP_DIR__/frontend/dist;
        try_files $uri $uri/ /index.html;
        index index.html;
    }
}

# Отключите/закоментируйте, если используете dev-режим (Vite на :5173) — тогда
# location / { proxy_pass http://127.0.0.1:5173; } вместо статики.
