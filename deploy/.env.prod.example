# ============================================================
# Прод-окружение Townhouse ERP (NAS Synology, docker-compose.prod.yml).
#
#   cp deploy/.env.prod.example .env
#   # заполнить секреты ниже, затем:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
#
# ⚠️  .env в git НЕ коммитится (см. .gitignore).
# ⚠️  Без AUTH_SECRET_KEY бэкенд поднимет dev-секрет (небезопасно!).
# ============================================================

# --- Версия образов (ghcr.io/asagat/townhouse-app-*) ------------------
# Фиксируем релизный тег, а не main: выкат = смена тега, откат = возврат тега.
# Релизные образы публикуются workflow docker-build.yml по тегу вида v1.2.3.
TOWNHOUSE_TAG=1.0.0

# --- База данных (контейнер postgres:16-alpine в этом же compose) -----
POSTGRES_USER=townhouse_user
# Сгенерируйте: openssl rand -base64 32
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ
POSTGRES_DB=townhouse

# --- Бэкенд ----------------------------------------------------------
# JWT-секрет подписи токенов. Сгенерируйте: openssl rand -hex 32
AUTH_SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_СЕКРЕТ
# Пароль администратора (используется create_user.py при первичном развёртывании)
ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_ПАРОЛЬ_АДМИНИСТРАТОРА
# Разрешённые источники для CORS — внешний HTTPS-адрес приложения.
# Несколько доменов — через запятую, без пробелов.
CORS_ORIGINS=https://fth.sagacloud.synology.me

# --- Фронтенд --------------------------------------------------------
# Порт контейнера фронтенда на хосте NAS. DSM «Обратный прокси» ведёт сюда.
APP_PORT=8080
