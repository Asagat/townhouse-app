# ============================================================================
# Демо-контур (demo.sagacloud.synology.me) — ШАБЛОН окружения.
# ============================================================================
# Скопировать рядом как `.env` (файл в git не попадает) и заменить CHANGE_ME
# на свои значения. Секреты ДЕМО-контура должны отличаться от прод-контура:
#     cd deploy/demo && cp .env.demo.example .env
#
# Значения ниже — только местозаполнители, чтобы `docker compose config` проходил
# проверку; с ними НЕ запускать.

# --- Доступ к БД демо-контура (свой volume, данные вымышленные) -------------
POSTGRES_USER=townhouse_user
POSTGRES_PASSWORD=CHANGE_ME_demo_db_password
POSTGRES_DB=townhouse_demo

# --- Приложение ------------------------------------------------------------
# Секрет подписи JWT. Сгенерировать: openssl rand -hex 32
AUTH_SECRET_KEY=CHANGE_ME_demo_auth_secret
# Пароль администратора демо-контура (заводится/обновляется create_user.py).
ADMIN_PASSWORD=CHANGE_ME_demo_admin_password
# Домен(ы) фронтенда для CORS — через запятую.
CORS_ORIGINS=https://demo.sagacloud.synology.me
# Документация API (/docs, /redoc, /openapi.json).
# Демо показываем внешним зрителям, и Swagger там полезен для демонстрации
# возможностей API. Если демо станет публичным надолго — выключите (`false`).
ENABLE_DOCS=true

# --- Порты и версия образов ------------------------------------------------
# Наружу отдаётся только фронтенд; DSM «Обратный прокси» маршрутизирует
# demo.sagacloud.synology.me → http://<NAS>:8081 (HTTPS — сертификат DSM).
APP_PORT=8081
# Демо-контур: едет за последним релизом (в отличие от прода, где тег фиксируем
# вручную — см. deploy/.env.prod.example). `latest` ставит GitHub на последний
# релизный тег v*; при выкате нового релиза демо обновится по кнопке без правок
# этого файла.
#
# ВНИМАНИЕ: `latest` — плавающая ссылка. Она годится для демо, но НЕ для прода:
# на проде нужен фиксированный тег, иначе не будет воспроизводимости и отката.
#
# Образ обязан содержать backend/migrations/seed_demo_data.py (появился в v1.0.6).
TOWNHOUSE_TAG=latest
