# Пример переменных фронтенда (Vite).
# Скопируйте в frontend/.env и при необходимости измените:
#   cp .env.example .env
# (npm run predev — «ensure-env» — копирует файл сам, если .env отсутствует.)

# Адрес БЭКЕНДА (без суффикса /api) для dev-прокси /api.
# Благодаря прокси в vite.config.ts фронтенд на :5173 сам переадресует запросы /api
# на бэкенд — внешний адрес и CORS для локальной разработки не нужны.
VITE_PROXY_TARGET=http://localhost:8000

# Хост и порт dev-сервера Vite (для локальной разработки — localhost).
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# Примечание: VITE_API_URL (полный адрес API, напр. http://localhost:8000/api)
# в коде фронтенда не используется и для dev-прокси не требуется.
