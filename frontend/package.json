{
  "name": "townhouse-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ensure-env": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')&&fs.existsSync('.env.example')){fs.copyFileSync('.env.example','.env');console.log('created frontend/.env from .env.example')}else{console.log('frontend/.env already present')}\"",
    "predev": "npm run ensure-env",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@refinedev/core": "^4.54.0",
    "@refinedev/react-router-v6": "^4.5.3",
    "@refinedev/simple-rest": "^4.5.0",
    "antd": "^5.14.0",
    "axios": "^0.26.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vitest": "^2.1.9"
  }
}
