# ============================================================
# Пример конфигурации (.env.example).
# Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# .env НЕ коммитится в git (см. .gitignore).
# Каждая среда (локально / VPS) должна иметь свой .env.
# ============================================================

# --- База данных (бэкенд) ---
# Вариант А: задать строку подключения напрямую (приоритет).
#   postgresql://USER:PASS@HOST:PORT/DB
# Локально:  postgresql://postgres:postgres@127.0.0.1:5432/townhouse_db
# На VPS:    замените юзер/пароль/хост
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/townhouse_db
#
# Вариант Б (без DATABASE_URL): указать компоненты — URL соберётся автоматически
# (database.py). Это удобно для локальной разработки и docker-compose.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=townhouse

# --- Разрешения (бэкенд) ---
# Пароль для create_user.py, если запускается без --password (необязательно):
# ADMIN_PASSWORD=my-super-secret-password
# Логин по умолчанию для create_user.py:
# ADMIN_USERNAME=admin
# JWT-секрет. В продакшене ОБЯЗАТЕЛЬНО свой длинный случайный (напр. `python -c "import secrets;print(secrets.token_hex(32))"`).
AUTH_SECRET_KEY=dev-only-insecure-secret-change-me
# Время жизни токена, сек (по умолчанию 28800 = 8 ч).
AUTH_TOKEN_TTL_SECONDS=28800

# --- CORS (бэкенд) ---
# Разрешённые источники через запятую. localhost:5173 — для локального dev.
CORS_ORIGINS=https://townhouse.sagacloud.kz,http://localhost:5173

# --- Фронтенд (Vite) ---
# Базовый URL API. Vite сам подменяет VITE_* во время сборки на серверной стороне.
VITE_API_URL=/api
# Для локального dev: адрес, на котором доступен бэкенд.
# VITE_API_URL=http://localhost:8000/api

# Хост/порт dev-сервера Vite. Локально раскомментируйте VITE_DEV_HOST=localhost,
# на VPS оставьте по умолчанию (townhouse.sagacloud.kz).
# VITE_DEV_HOST=localhost
# VITE_DEV_PORT=5173
